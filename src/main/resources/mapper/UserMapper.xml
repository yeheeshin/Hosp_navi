<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.Hosp.navi.mapper.UserMapper">
    <insert id="saveUser" parameterType="com.Hosp.navi.domain.user">
        INSERT INTO "user" (username, password, email, phone, role, position, hospital)
        VALUES (#{username}, #{password}, #{email}, #{phone}, #{role}, #{position}, #{hospital})
    </insert>

    <select id="findByEmail" resultType="com.Hosp.navi.domain.user">
        select * from "user" where email = #{email}
    </select>
</mapper>
